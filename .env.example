# WooCommerce Production Backend URL
NEXT_PUBLIC_WC_URL=https://intersting.duckdns.org

# Production site URL (used in SMS tracking links)
NEXT_PUBLIC_SITE_URL=https://intersting.duckdns.org

# ─── Direct UPI Payment Settings (Zero gateway KYC required) ─────────────────
NEXT_PUBLIC_STORE_UPI_ID=your_upi_id@upi
NEXT_PUBLIC_STORE_UPI_NAME=INTERSTING

# ─── Auth Method 1: WooCommerce REST Consumer Key/Secret (Recommended) ─────────
WC_CONSUMER_KEY=ck_your_consumer_key
WC_CONSUMER_SECRET=cs_your_consumer_secret

# ─── Auth Method 2: WordPress Application Password (Alternative) ─────────────
WC_APP_USER=your_wordpress_username
WC_APP_PASSWORD=your_application_password

# ─── Auth: Google OAuth 2.0 (Optional) ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret key for signing customer session cookies
SESSION_SECRET=your-random-secret-key-here

# ─── Firebase Authentication & Firestore ─────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ─── httpSMS (https://httpsms.com) SMS Gateway ────────────────────────────────
# API Key from https://httpsms.com/settings
HTTPSMS_API_KEY=your_httpsms_api_key_here
# Sender phone number registered in your httpSMS Android app (in E.164 format, e.g. +919876543210)
HTTPSMS_FROM_PHONE=+919876543210
# Optional: Store owner/admin phone number for instant order alerts
HTTPSMS_ADMIN_PHONE=
# Optional: Fallback country code if phone number is entered without country code (default +91)
DEFAULT_PHONE_COUNTRY_CODE=+91
# Master switch to enable/disable SMS (true / false)
HTTPSMS_ENABLED=true

# WooCommerce Webhook Secret for validating incoming order webhooks
WC_WEBHOOK_SECRET=your_woocommerce_webhook_secret_here
